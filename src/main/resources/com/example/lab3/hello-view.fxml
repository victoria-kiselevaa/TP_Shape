<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.StackPane?>
<VBox alignment="CENTER" prefHeight="674.0" prefWidth="559.0" spacing="20.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.lab3.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <StackPane xmlns:fx="http://javafx.com/fxml" xmlns="http://javafx.com/javafx/8.0.171">
        <Canvas fx:id="canvas" height="264.0" onMouseClicked="#onMouseClick" onMouseDragged="#MouseDragged" onMouseReleased="#MouseReleased" width="441.0" />
        <Canvas fx:id="canvas2" height="264.0" onMouseClicked="#onMouseClick" onMouseDragged="#MouseDragged" onMouseReleased="#MouseReleased" width="441.0" />
        <Canvas fx:id="canvas3" height="264.0" onMouseClicked="#onMouseClick" onMouseDragged="#MouseDragged" onMouseReleased="#MouseReleased" width="441.0" />
    </StackPane>
      <GridPane prefHeight="162.0" prefWidth="519.0">
     <columnConstraints>
       <ColumnConstraints hgrow="SOMETIMES" maxWidth="369.5999755859375" minWidth="10.0" prefWidth="355.99998779296874" />
       <ColumnConstraints hgrow="SOMETIMES" maxWidth="255.20001220703125" minWidth="10.0" prefWidth="163.2000122070313" />
     </columnConstraints>
     <rowConstraints>
       <RowConstraints maxHeight="102.60001220703126" minHeight="10.0" prefHeight="57.9999755859375" vgrow="SOMETIMES" />
       <RowConstraints maxHeight="168.1999839782715" minHeight="10.0" prefHeight="75.79999999999998" vgrow="SOMETIMES" />
         <RowConstraints maxHeight="168.1999839782715" minHeight="10.0" prefHeight="33.400000000000006" vgrow="SOMETIMES" />
     </rowConstraints>
      <children>
          <TextField fx:id="textF" prefHeight="26.0" prefWidth="157.0" />
          <Label prefHeight="66.0" prefWidth="391.0" text="Введите цифру соответствующую желаемой фигуре, выберите её цвет и щёлкните в той части экрана, где хотели бы её нарисовать    1-Линия; 2-Прямоугольник;3-Шестиугольник" wrapText="true" GridPane.rowIndex="1" />
         <ListView fx:id="listView" onMouseClicked="#drawShape" prefHeight="61.0" prefWidth="164.0" GridPane.columnIndex="1" />
          <ColorPicker fx:id="color" onAction="#OnClick" prefHeight="32.0" prefWidth="139.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
         <CheckBox fx:id="checkText" mnemonicParsing="false" onAction="#TextCh" prefHeight="18.0" prefWidth="122.0" text=" Добавить текст" GridPane.rowIndex="2" />
         <CheckBox fx:id="checkBorder" mnemonicParsing="false" onAction="#BordrerCh" prefHeight="18.0" prefWidth="137.0" text="Добавить контур" GridPane.columnIndex="1" GridPane.rowIndex="2" />
      </children>
   </GridPane>
    <Button fx:id="ButReturn" mnemonicParsing="false" onAction="#ButReturnClick" text="Назад" />
</VBox>
